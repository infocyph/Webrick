{
    "name": "infocyph/webrick",
    "description": "A fast, modern PHP router with production-grade middleware, signed & temporary URLs, smart responses and first-class route caching.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "router",
        "routing",
        "http",
        "web",
        "framework",
        "middleware",
        "psr-7",
        "psr-15",
        "opentelemetry"
    ],
    "authors": [
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Infocyph\\Webrick\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Webrick\\Tests\\": "tests/"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "require": {
        "php": ">=8.4",
        "infocyph/arraykit": "^2.03",
        "infocyph/intermix": "^5.35"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-drift": "^4.1",
        "psr/log": "^3.0",
        "rector/rector": "^2.3",
        "symfony/var-dumper": "^7.3 || ^8.0",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "open-telemetry/sdk": "Full OpenTelemetry tracing with automatic span export (auto-detected by TelemetryMiddleware)",
        "open-telemetry/exporter-otlp": "Export traces to OpenTelemetry collectors (Jaeger, Zipkin, etc.)",
        "psr/http-factory": "PSR-17 HTTP factories for framework interoperability",
        "psr/http-server-middleware": "PSR-15 middleware support"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-drift": true
        }
    },
    "scripts": {
        "test:code": "@php vendor/bin/pest --parallel --processes=10",
        "test:security": "@php vendor/bin/psalm --security-analysis --show-info=false --no-progress --threads=1",
        "test:refactor": "@php vendor/bin/rector process --dry-run",
        "test:lint": "@php vendor/bin/pint --test",
        "test:hook": [
            "captainhook hook:post-checkout",
            "captainhook hook:pre-commit",
            "captainhook hook:post-commit",
            "captainhook hook:post-merge",
            "captainhook hook:post-rewrite",
            "captainhook hook:pre-push"
        ],
        "tests": [
            "@test:code",
            "@test:lint",
            "@test:refactor",
            "@test:security"
        ],
        "git:hook": "captainhook install --only-enabled -nf",
        "test": "@php vendor/bin/pest",
        "bench:hello": "@php bench/hello_matchers.php",
        "refactor": "@php vendor/bin/rector process",
        "lint": "@php vendor/bin/pint",
        "security:scan": "@test:security",
        "webrick": "webrick",
        "post-autoload-dump": "captainhook install --only-enabled -nf"
    },
    "bin": [
        "webrick"
    ]
}
