{
    "name": "infocyph/webrick",
    "description": "A fast, modern PHP router with production-grade middleware, signed & temporary URLs, smart responses and first-class route caching.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "router",
        "routing",
        "http",
        "middleware",
        "http-kernel",
        "php-router",
        "route-cache",
        "signed-url",
        "opentelemetry"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "infocyph/intermix": "^11.2.1",
        "psr/cache": "^3.0",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "infocyph/cachelayer": "^4.0.2",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "^3.0.1",
        "opis/closure": "^4.5",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "suggest": {
        "ext-intl": "Enables optional Unicode NFKC normalization in InputSanitizer.",
        "infocyph/cachelayer": "Provides Webrick-tested CacheLayer 4 PSR-6 stores/default response-cache backing and the optional atomic-counter adapter.",
        "infocyph/runwire": "Enables the optional Runwire 3 HTTP runtime integration; the host owns workers, event loops and graceful draining.",
        "open-telemetry/exporter-otlp": "Export traces to OpenTelemetry collectors (Jaeger, Zipkin, etc.)",
        "open-telemetry/sdk": "Full OpenTelemetry tracing with automatic span export (auto-detected by TelemetryMiddleware)",
        "opis/closure": "Required only when compiling route or middleware Closures into persistent artifacts through InterMix.",
        "psr/http-factory": "Optional PSR-17 factories for Webrick's explicit PSR-7 interoperability bridge.",
        "psr/http-message": "Optional PSR-7 message interfaces for interoperability adapters."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\Webrick\\": "src/"
        },
        "files": [
            "src/Router/Matching/matcher_functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\Webrick\\Benchmarks\\": "benchmarks/",
            "Infocyph\\Webrick\\Tests\\Fixture\\": "tests/Fixtures/"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "bin": [
        "webrick"
    ],
    "archive": {
        "exclude": [
            "/.agents",
            "/.aws",
            "/.codex",
            "/.route-cache",
            "/.route-cache-*",
            "/.runtime-certification",
            "/composer.lock",
            "/graphify-out",
            "/phpforge",
            "/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true,
            "pestphp/pest-plugin-drift": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "phpforge": {
            "skipper_policy": {
                "default": "deny",
                "rules": [
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/HeaderLine.php"
                        ],
                        "reason": "Header grammar is validated at SAPI emission; only response-splitting taint is removed. Review on grammar or Psalm sanitizer-model changes.",
                        "security": {
                            "sanitizer": "src/Support/HeaderLine.php",
                            "sha256": "e24139091ae9361b6534f5f7b99f578d37fa97511fac9a85c1823bb55d5c48a4",
                            "tests": [
                                "tests/Unit/HeaderLineTest.php"
                            ]
                        },
                        "taint": "header"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Router/Matching/matcher_functions.php"
                        ],
                        "reason": "Filename components cannot contain separators, wrappers or leading dots; the deployment owns the cache directory. Review on filename grammar or Psalm model changes.",
                        "security": {
                            "sanitizer": "src/Router/Matching/matcher_functions.php",
                            "sha256": "ff0c0d8efbd386f6a69a312ce0f850a33c6ce221e9eb9317c36c2bae6b69a749",
                            "tests": [
                                "tests/Unit/ShardedMatcherFilenameSecurityTest.php"
                            ]
                        },
                        "taint": "include"
                    },
                    {
                        "directive": "@psalm-suppress",
                        "issue": "UnusedVariable",
                        "paths": [
                            "src/Runtime/Http/RunwireResponseContinuation.php"
                        ],
                        "reason": "Psalm 7.10 misses reads through the escaped by-reference drain closure after finally. Clearing releases the retained Fiber; keep until upstream reference escape analysis is corrected."
                    },
                    {
                        "directive": "@psalm-suppress",
                        "issue": "UnusedMethodCall",
                        "paths": [
                            "src/Runtime/Http/RunwireResponseContinuation.php"
                        ],
                        "reason": "Psalm 7.10 misclassifies Fiber::suspend as an unused result; suspension transfers execution and is required for I/O. Remove when upstream models suspension effects."
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/cert-server.php"
                        ],
                        "reason": "Certification checkout paths are explicitly operator-selected via CLI or host environment; local-only directory validation rejects wrappers, NUL and network shares. Never use this authority boundary for HTTP request input; review on root loading changes.",
                        "security": {
                            "sanitizer": ".github/certification/cert-server.php",
                            "sha256": "18e6ce45edf9d84df811ea1e337c631272498a9fb626ff7d0e8edd4e76915b48",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/cert-server.php"
                        ],
                        "reason": "Certification checkout paths are explicitly operator-selected via CLI or host environment; local-only directory validation rejects wrappers, NUL and network shares. Never use this authority boundary for HTTP request input; review on root loading changes.",
                        "security": {
                            "sanitizer": ".github/certification/cert-server.php",
                            "sha256": "18e6ce45edf9d84df811ea1e337c631272498a9fb626ff7d0e8edd4e76915b48",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "ssrf"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/cert-server.php"
                        ],
                        "reason": "Certification checkout paths are explicitly operator-selected via CLI or host environment; local-only directory validation rejects wrappers, NUL and network shares. Never use this authority boundary for HTTP request input; review on root loading changes.",
                        "security": {
                            "sanitizer": ".github/certification/cert-server.php",
                            "sha256": "18e6ce45edf9d84df811ea1e337c631272498a9fb626ff7d0e8edd4e76915b48",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "include"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/analyze-load.php"
                        ],
                        "reason": "CLI operators choose local evidence and report paths; canonical local file/directory validation rejects wrappers, NUL and network shares. Data taints and executable-include taint remain intact; review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/analyze-load.php",
                            "sha256": "9db67179b816932161e4ff8c4d29f6a93e525c35b61101b0abb89e78ffa875dc",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/analyze-load.php"
                        ],
                        "reason": "CLI operators choose local evidence and report paths; canonical local file/directory validation rejects wrappers, NUL and network shares. Data taints and executable-include taint remain intact; review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/analyze-load.php",
                            "sha256": "9db67179b816932161e4ff8c4d29f6a93e525c35b61101b0abb89e78ffa875dc",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "ssrf"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/cert-server.php"
                        ],
                        "reason": "Only operator-selected, validated local filesystem names reach these certification I/O calls. URL taints here represent network authority, not URL encoding; never use this boundary for request input or URL construction. Review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/cert-server.php",
                            "sha256": "18e6ce45edf9d84df811ea1e337c631272498a9fb626ff7d0e8edd4e76915b48",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/cert-server.php"
                        ],
                        "reason": "Only operator-selected, validated local filesystem names reach these certification I/O calls. URL taints here represent network authority, not URL encoding; never use this boundary for request input or URL construction. Review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/cert-server.php",
                            "sha256": "18e6ce45edf9d84df811ea1e337c631272498a9fb626ff7d0e8edd4e76915b48",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "url_path"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/analyze-load.php"
                        ],
                        "reason": "Only operator-selected, validated local filesystem names reach these certification I/O calls. URL taints here represent network authority, not URL encoding; never use this boundary for request input or URL construction. Review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/analyze-load.php",
                            "sha256": "9db67179b816932161e4ff8c4d29f6a93e525c35b61101b0abb89e78ffa875dc",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            ".github/certification/analyze-load.php"
                        ],
                        "reason": "Only operator-selected, validated local filesystem names reach these certification I/O calls. URL taints here represent network authority, not URL encoding; never use this boundary for request input or URL construction. Review on path or input-source changes.",
                        "security": {
                            "sanitizer": ".github/certification/analyze-load.php",
                            "sha256": "9db67179b816932161e4ff8c4d29f6a93e525c35b61101b0abb89e78ffa875dc",
                            "tests": [
                                "tests/Unit/CertificationPathBoundaryTest.php"
                            ]
                        },
                        "taint": "url_path"
                    }
                ]
            }
        }
    },
    "scripts": {
        "benchmark": "@php benchmark/hello_matchers.php",
        "webrick": "@php webrick"
    }
}
