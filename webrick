#!/usr/bin/env php
<?php
require __DIR__ . '/vendor/autoload.php';

$argv[1] ??= '';
match ($argv[1]) {
    'route:list'   => \Infocyph\Webrick\Router\CLI\RouteListCommand::run($argv),
    'route:openapi'=> \Infocyph\Webrick\Router\CLI\RouteOpenApiCommand::run($argv),
    default        => fwrite(STDERR, "Unknown command {$argv[1]}\n"),
};

