$watcher = class_exists(\Infocyph\Webrick\Router\Dev\InotifyWatcher::class)
    ? \Infocyph\Webrick\Router\Dev\InotifyWatcher::class
    : \Infocyph\Webrick\Router\Dev\RouteCacheWatcher::class;

$watcher::run(
    paths: ['routes/*.php', 'app/Http/Controllers'],
    compiler: static function (\Infocyph\Webrick\Router\RouteCollection $r) {
        require __DIR__ . '/routes/web.php';  // your route definitions
    }
);
