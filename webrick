#!/usr/bin/env php
<?php

declare(strict_types=1);

use Infocyph\Webrick\Constants\MatcherModeEnum;
use Infocyph\Webrick\Support\RouteCache;
use Psr\Log\NullLogger;

$autoload = $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/vendor/autoload.php';
require $autoload;

/** @param array<int,string> $argv @return array{cmd:string,opts:array<string,string|bool>} */
function parse_argv(array $argv): array
{
    array_shift($argv);
    $cmd = array_shift($argv) ?? 'help';
    $opts = [];
    $pending = null;

    foreach ($argv as $token) {
        if ($pending !== null) {
            $opts[$pending] = $token;
            $pending = null;
            continue;
        }
        if (!str_starts_with($token, '--')) {
            continue;
        }

        $option = substr($token, 2);
        $equals = strpos($option, '=');
        if ($equals !== false) {
            $opts[substr($option, 0, $equals)] = substr($option, $equals + 1);
            continue;
        }

        $pending = $option;
        $opts[$option] = true;
    }

    return ['cmd' => $cmd, 'opts' => $opts];
}

function out(string $message): void
{
    fwrite(STDOUT, $message);
}

function err(string $message): void
{
    fwrite(STDERR, $message);
}

/** @return array<string,string> */
function parse_attribute_dirs(mixed $value): array
{
    if (!is_string($value) || $value === '') {
        return [];
    }

    $dirs = [];
    foreach (array_filter(array_map(trim(...), explode(',', $value))) as $pair) {
        [$namespace, $dir] = array_pad(explode('=', $pair, 2), 2, '');
        if ($namespace !== '' && $dir !== '') {
            $dirs[$namespace] = $dir;
        }
    }

    return $dirs;
}

/** @return list<string> */
function parse_attribute_classes(mixed $value): array
{
    return is_string($value) && $value !== ''
        ? array_values(array_filter(array_map(trim(...), explode(',', $value))))
        : [];
}

$parsed = parse_argv($_SERVER['argv'] ?? []);
$cmd = $parsed['cmd'];
$opts = $parsed['opts'];
$matcherValues = implode('|', MatcherModeEnum::values());

$usage = <<<TXT
Webrick matcher-cache CLI

USAGE:
  webrick route:cache --matcher={$matcherValues} --cache=PATH --routes=PATH [--signkey=KEY] [--ttl=900] [--attr-dirs="Ns\\=dir,..."] [--attr-classes="FQCN1,FQCN2"]
  webrick route:clear --matcher={$matcherValues} --cache=PATH [--aggressive=1|0]

NOTES:
  - route:cache builds matcher cache only; it does not boot a request kernel or DI runtime.
  - Sharded cache uses a directory; fused/generated cache uses a PHP file.
  - Production release artifacts are built through Router\\Build\\ReleaseCompiler.
TXT;

if ($cmd === 'route:cache') {
    $cache = (string) ($opts['cache'] ?? (__DIR__ . '/.route-cache'));
    $routes = (string) ($opts['routes'] ?? (__DIR__ . '/routes.php'));
    $matcher = isset($opts['matcher']) ? strtolower((string) $opts['matcher']) : null;
    if ($matcher !== null && !in_array($matcher, MatcherModeEnum::values(), true)) {
        err("Invalid matcher '{$matcher}'. Allowed: " . implode(', ', MatcherModeEnum::values()) . "\n");
        exit(2);
    }

    try {
        $sentinel = RouteCache::build([
            'matcher' => $matcher,
            'cache' => $cache,
            'routes' => $routes,
            'signKey' => isset($opts['signkey']) ? (string) $opts['signkey'] : null,
            'signedDefaultTtl' => (int) ($opts['ttl'] ?? 900),
            'registrarOptions' => ['autoSlashRedirect' => false],
            'attributeDirs' => parse_attribute_dirs($opts['attr-dirs'] ?? null),
            'attributeClasses' => parse_attribute_classes($opts['attr-classes'] ?? null),
            'logger' => new NullLogger(),
        ]);
    } catch (Throwable $error) {
        err("route:cache failed: {$error->getMessage()}\n");
        exit(2);
    }

    out("Matcher cache ready at: {$sentinel}\n");
    exit(0);
}

if ($cmd === 'route:clear') {
    $cache = (string) ($opts['cache'] ?? (__DIR__ . '/.route-cache'));
    $matcher = isset($opts['matcher']) ? strtolower((string) $opts['matcher']) : null;
    if ($matcher !== null && !in_array($matcher, MatcherModeEnum::values(), true)) {
        err("Invalid matcher '{$matcher}'. Allowed: " . implode(', ', MatcherModeEnum::values()) . "\n");
        exit(4);
    }

    try {
        $removed = RouteCache::clear([
            'matcher' => $matcher,
            'cache' => $cache,
            'aggressive' => filter_var((string) ($opts['aggressive'] ?? '0'), FILTER_VALIDATE_BOOL),
        ]);
    } catch (Throwable $error) {
        err("route:clear failed: {$error->getMessage()}\n");
        exit(4);
    }

    out($removed ? "Matcher cache cleared: {$cache}\n" : "Nothing to clear at: {$cache}\n");
    exit(0);
}

out($usage . PHP_EOL);
