#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Infocyph\Webrick\Request\Request;
use Infocyph\Webrick\Router\CLI\CommandKernel;
use Infocyph\Webrick\Router\Kernel\RouterKernel;

$container = require dirname(__DIR__) . '/bootstrap/app.php';
/** @var RouterKernel $kernel */
$kernel = $container->get(RouterKernel::class);

/* --------------------------------------------------------------
 * tiny helper – cheap PSR-7 request builder
 * ------------------------------------------------------------ */
$mkReq = static function (string $verb, string $path): Request {
    // scheme/host don’t matter for the router, keep them synthetic
    return new Request($verb, 'http://bench' . $path);
};

/* --------------------------------------------------------------
 * CLI
 * ------------------------------------------------------------ */
$cli = new CommandKernel([
    // bin/router bench GET /ping [iterations]
    'bench' => static function (array $args) use ($kernel, $mkReq): int {
        $verb = strtoupper($args[0] ?? 'GET');
        $path = $args[1]        ?? '/';
        $n    = (int)($args[2]  ?? 1000);

        $req  = $mkReq($verb, $path);   // build once (immutable)

        $t0 = hrtime(true);
        for ($i = 0; $i < $n; ++$i) {
            $kernel->handle($req);
        }
        $µsTotal = (hrtime(true) - $t0) / 1_000;   // nano → µs

        printf(
            "%s %s × %d  →  %.1f µs/op  (%.2f ms total)\n",
            $verb,
            $path,
            $n,
            $µsTotal / $n,
            $µsTotal / 1_000
        );
        return 0;
    },

    'help' => static function (): int {
        echo <<<TXT
Usage:
  bin/router bench <VERB> <PATH> [iterations]
      e.g.  bin/router bench GET /ping 5000

TXT;
        return 0;
    },
]);

exit($cli->handle($_SERVER['argv']));
